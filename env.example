# Скопируйте этот файл в .env и при необходимости поменяйте значения

# Порт, на котором сервер доступен снаружи контейнера (docker compose)
API_PORT=5000

# Режим отладки Flask (False для сервера)
DEBUG=False
FLASK_ENV=production

# Использовать HTTPS для работы с микрофоном (true/false)
# Для разработки рекомендуется true
USE_SSL=true

# Local account database and session signing key (both persistent and excluded from Git)
# AUTH_DATA_DIR=auth_data
# SECRET_KEY=<optional random secret; otherwise generated in AUTH_DATA_DIR/session.key>
# For HTTPS production use true; for local HTTP development use false.
# SESSION_COOKIE_SECURE=false

# IP-адрес сервера для добавления в SSL сертификат (опционально)
# Если сервер доступен по IP (например, 10.53.16.53), укажите его здесь
# Сертификат будет автоматически пересоздан с этим IP при следующем запуске
# SERVER_IP=10.53.16.53
